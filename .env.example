# V2G-Benchmark-OneShot environment variables
# Copy to .env and fill in your credentials.
# NEVER commit .env to git.

ALPHAGENOME_API_KEY=your_api_key_here
SYNAPSE_AUTH_TOKEN=your_synapse_token_here
GITHUB_TOKEN=your_github_token_here

# Optional: HPC root path for SLURM execution
HPC_ROOT=/path/to/hpc/scratch

# SLURM partitions (only needed for SLURM mode)
SLURM_PARTITION_CPU=cpu
SLURM_PARTITION_GPU=gpu
